{
  "name": "york3d-toyota-lc200",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "validate:model": "tsx scripts/validate-model.ts",
    "build": "tsc --noEmit && vite build",
    "validate:production": "npm run validate:model && npm run build && node scripts/validate-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "description": "Unofficial bilingual LC200-inspired procedural 3D vehicle study with 350 interactive components"
}
